+        "assignment": {
+            "95": {"strike": 95.0, "iv": 0.32, "prob_otm": 0.71, "prob_assigned": 0.29},
+            "90": {"strike": 90.0, "iv": 0.35, "prob_otm": 0.80, "prob_assigned": 0.20},
